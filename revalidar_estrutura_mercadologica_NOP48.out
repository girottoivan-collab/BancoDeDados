---------------------
##ARVORE_JOIN        

  1 registro(s) selecionado(s).


select e.IDESTRUTURA, e.DESCRESTRUTURA, e.IDESTRUTURAPAI, n.IDNIVELESTRUTURA, c.DESCRNIVEL from DBA.ESTRUTURA_MERCADOLOGICA e left join DBA.ESTRUTURA_MERCADOLOGICA_NIVEIS n on n.IDESTRUTURA = e.IDESTRUTURA left join DBA.CONFIG_NIVEIS_ESTRUTURA_MERCADOLOGICA c on c.IDNIVELESTRUTURA = n.IDNIVELESTRUTURA order by e.IDESTRUTURA, n.IDNIVELESTRUTURA fetch first 100 rows only

