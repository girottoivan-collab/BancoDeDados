    USUARIO {
        INTEGER IDUSUARIO PK
    }

    TAREFA {
        INTEGER IDTAREFA PK
    }

    AGENDAMENTO_EXECUCAO {
        INTEGER IDAGENDAMENTOEXECUCAO PK
        INTEGER IDUSUARIOGRUPO FK
    }

    TAREFA_PERFIL_EMPRESA {
        INTEGER IDTAREFAPERFILEMPRESA PK
    }

    CHECKLIST {
        INTEGER IDCHECKLIST PK
        VARCHAR_100 DSCHECKLIST
        TIMESTAMP DHCRIACAO
        TIMESTAMP DHALTERACAO
        SMALLINT FGATIVO "DEFAULT 1; CHECK 0,1"
        INTEGER IDUSUARIOCRIACAO FK
        INTEGER IDUSUARIOALTERACAO FK
    }

    CHECKLIST_SECAO {
        INTEGER IDCHECKLISTSECAO PK
        INTEGER IDCHECKLIST FK
        VARCHAR_100 DSSECAO
        SMALLINT NRORDEM
        SMALLINT FGATIVO "DEFAULT 1; CHECK 0,1"
    }

    CHECKLIST_SECAO_PERGUNTA {
        INTEGER IDCHECKLISTSECAOPERGUNTA PK
        INTEGER IDCHECKLISTSECAO FK
        VARCHAR_100 DSPERGUNTA
        SMALLINT NRORDEM
        SMALLINT TPRESPOSTA "CHECK 1,2,3,4"
        SMALLINT NRPESOPERGUNTA "DEFAULT 1"
        SMALLINT NRPONTOCORTE
        SMALLINT FGEXIGEFOTO "DEFAULT 0; CHECK 0,1"
        SMALLINT FGEXIGECOMENTARIO "DEFAULT 0; CHECK 0,1"
        SMALLINT FGATIVO "DEFAULT 1; CHECK 0,1"
    }

    CHECKLIST_SECAO_PERGUNTA_OPCAO {
        INTEGER IDCHECKLISTSECAOPERGUNTAOPCAO PK
        INTEGER IDCHECKLISTSECAOPERGUNTA FK
        VARCHAR_50 DSOPCAO
        SMALLINT NRORDEM
        SMALLINT FGNAOCONFORMIDADE "DEFAULT 0; CHECK 0,1"
        SMALLINT FGATIVO "DEFAULT 1; CHECK 0,1"
    }

    TAREFA_CHECKLIST {
        INTEGER IDTAREFACHECKLIST PK
        INTEGER IDTAREFA FK "UK"
        INTEGER IDCHECKLIST FK
    }

    AGENDAMENTO_EXECUCAO_CHECKLIST {
        BIGINT IDAGENDAMENTOEXECUCAOCHECKLIST PK
        INTEGER IDAGENDAMENTOEXECUCAO FK "UK"
        INTEGER IDCHECKLIST FK
        SMALLINT TPSTATUS "DEFAULT 0; CHECK 0,1,2"
        TIMESTAMP DHFINALIZACAO
        VARCHAR_200 DSPATHASSINATURA
    }

    AGENDAMENTO_EXECUCAO_CHECKLIST_RESPOSTA {
        BIGINT IDAGENDAMENTOEXECUCAOCHECKLISTRESPOSTA PK
        BIGINT IDAGENDAMENTOEXECUCAOCHECKLIST FK "UK composto"
        INTEGER IDCHECKLISTSECAOPERGUNTA FK "UK composto"
        SMALLINT NRRESPOSTA
        VARCHAR_200 DSRESPOSTA
        VARCHAR_200 DSCOMENTARIO
    }

    AGENDAMENTO_EXECUCAO_CHECKLIST_RESPOSTA_OPCAO {
        BIGINT IDAGENDAMENTOEXECUCAOCHECKLISTRESPOSTAOPCAO PK
        BIGINT IDAGENDAMENTOEXECUCAOCHECKLISTRESPOSTA FK
        INTEGER IDCHECKLISTSECAOPERGUNTAOPCAO FK
    }

    AGENDAMENTO_EXECUCAO_CHECKLIST_RESPOSTA_IMAGEM {
        BIGINT IDAGENDAMENTOEXECUCAOCHECKLISTRESPOSTAIMAGEM PK
        BIGINT IDAGENDAMENTOEXECUCAOCHECKLISTRESPOSTA FK
        VARCHAR_200 DSPATHIMAGEM
    }

    TAREFA_PERFIL_EMPRESA_EMAIL {
        INTEGER IDTAREFAPERFILEMPRESAEMAIL PK
        INTEGER IDTAREFAPERFILEMPRESA FK
        VARCHAR_100 DSEMAIL
    }
