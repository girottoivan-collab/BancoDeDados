select d.IDDIVISAO, d.DESCRDIVISAO, d.IDNIVELESTRUTURA, c.DESCRNIVEL, d.IDESTRUTURAPAI, e.DESCRESTRUTURA from DBA.DIVISAO d left join DBA.CONFIG_NIVEIS_ESTRUTURA_MERCADOLOGICA c on c.IDNIVELESTRUTURA = d.IDNIVELESTRUTURA left join DBA.ESTRUTURA_MERCADOLOGICA e on e.IDESTRUTURA = d.IDESTRUTURAPAI where d.IDNIVELESTRUTURA is not null or d.IDESTRUTURAPAI is not null order by d.IDDIVISAO fetch first 50 rows only

