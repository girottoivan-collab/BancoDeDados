##FK_RULES_WITH_COLUMNS

  1 registro(s) selecionado(s).


select r.tabname, r.constname, strip(r.fk_colnames) as fk_colnames, r.reftabname, strip(r.pk_colnames) as pk_colnames, r.deleterule, r.updaterule from syscat.references r where (r.tabschema = 'DBA' and r.tabname in ('ESTRUTURA_MERCADOLOGICA', 'ESTRUTURA_MERCADOLOGICA_NIVEIS', 'CONFIG_NIVEIS_ESTRUTURA_MERCADOLOGICA', 'DIVISAO')) or (r.reftabschema = 'DBA' and r.reftabname in ('ESTRUTURA_MERCADOLOGICA', 'ESTRUTURA_MERCADOLOGICA_NIVEIS', 'CONFIG_NIVEIS_ESTRUTURA_MERCADOLOGICA')) order by r.tabname, r.constname

