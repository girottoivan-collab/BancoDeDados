select e.IDESTRUTURA, e.DESCRESTRUTURA, e.IDESTRUTURAPAI, n.IDNIVELESTRUTURA, c.DESCRNIVEL from DBA.ESTRUTURA_MERCADOLOGICA e join DBA.ESTRUTURA_MERCADOLOGICA_NIVEIS n on n.IDESTRUTURA = e.IDESTRUTURA join DBA.CONFIG_NIVEIS_ESTRUTURA_MERCADOLOGICA c on c.IDNIVELESTRUTURA = n.IDNIVELESTRUTURA where e.IDESTRUTURA between 900000001 and 900000004 order by e.IDESTRUTURA

